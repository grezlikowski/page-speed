{
    "name": "grezlikowski/page-speed-with-history",
    "description": "PageSpeed with History is a PHP package that provides a convenient way to track and analyze the performance of web pages over time. It allows developers to monitor page speed metrics, identify performance bottlenecks, and optimize their websites for better user experience.",
    "keywords": [
        "grezlikowski",
        "page-speed-with-history"
    ],
    "homepage": "https://github.com/grezlikowski/page-speed-with-history",
    "license": "MIT",
    "authors": [
        {
            "name": "Łukasz Gręźlikowski",
            "email": "lukasz@grezlikowski.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Grezlikowski\\PageSpeed\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grezlikowski\\PageSpeed\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
            "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
